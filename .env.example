# Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# PostgreSQL
# Use the Supabase pooled connection URL for normal API traffic.
DATABASE_URL=postgresql://postgres.project-ref:replace-me@pooler-host:6543/postgres?pgbouncer=true&connection_limit=5

# Use the direct connection URL only for Prisma migrations. If local IPv6 is
# unavailable, use the Supabase session-pooler URL instead.
DIRECT_URL=postgresql://postgres:replace-me@db.project-ref.supabase.co:5432/postgres

# Supabase Auth and private Storage
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Server-only credential. Never expose this value to the frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Comma-separated allowlists.
ALLOWED_EMAIL_DOMAINS=your-tiet-domain.example
CORS_ORIGINS=http://localhost:3000
